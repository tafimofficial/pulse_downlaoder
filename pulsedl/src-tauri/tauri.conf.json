{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseDL",
  "version": "1.0.0",
  "identifier": "com.pulsedl.turbo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PulseDL - Ultra Fast Turbo Downloader",
        "url": "index.html",
        "visible": true,
        "width": 1080,
        "height": 700,
        "minWidth": 840,
        "minHeight": 540,
        "center": true,
        "decorations": true,
        "backgroundColor": "#070a08"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
